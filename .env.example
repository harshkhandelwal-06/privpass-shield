APP_ENV=development
HOST=127.0.0.1
PORT=8000
APP_SECRET=change-me-to-a-32-byte-random-secret
COOKIE_SECURE=false
DATABASE_URL=sqlite:///./runtime/privpass.db
REDIS_URL=
HIBP_USER_AGENT=PrivPass-Shield/6.0
MAX_SCAN_MB=25
SESSION_MINUTES=60
RESET_MINUTES=15
CLIENT_PBKDF2_ITERATIONS=310000

# ---- AI features (optional) ----
# Without a key every AI feature runs in offline mode (deterministic rules/templates).
ANTHROPIC_API_KEY=
PRIVPASS_AI_MODEL=claude-sonnet-5
# PRIVPASS_AI_OFFLINE=1        # force offline mode even when a key is present
# PRIVPASS_DISABLE_ML=1        # disable the SecretGuard ML classifier (rules only)

# ---- Integrations (optional) ----
# GitHub token (fine-grained: Contents + Pull requests read/write) for private-repo scans and one-click fix PRs.
GITHUB_TOKEN=
# Slack / Teams / Discord incoming-webhook URL: HIGH/CRITICAL alerts are forwarded here.
ALERT_WEBHOOK_URL=
# Accept the offline 1M-password corpus when HIBP is unreachable (default: fail closed).
# PRIVPASS_BREACH_FALLBACK=local

# Your private real admin account (live workspace, never shown in the Demo Center).
# Leave the password empty and one is generated into runtime/ADMIN-CREDENTIALS.txt on first start.
PRIVPASS_ADMIN_EMAIL=
PRIVPASS_ADMIN_PASSWORD=
